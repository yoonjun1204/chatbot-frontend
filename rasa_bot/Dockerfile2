# rasa_bot/Dockerfile2
# rasa_server

FROM rasa/rasa:3.6.20-full

WORKDIR /app
USER root

# 1. Copy everything FROM rasa_bot/ INTO /app
COPY . . 

# DEBUG: This will list your files in the logs so we can see the truth
RUN ls -la

# 2. NOW you can change permissions because the folder exists
RUN chmod -R 777 /app/models

USER 1001

CMD ["run", "-m", "models", "--enable-api", "--cors", "*", "--port", "5005"]

