# rasa_bot/Dockerfile2
# rasa_server
FROM rasa/rasa:3.6.20-full

# Switch to root to install dependencies or change permissions
USER root

WORKDIR /app

# Copy the entire rasa_bot directory into the container
COPY . .

# Ensure the models directory exists and has correct permissions
RUN mkdir -p /app/models && chmod -R 777 /app

# Switch back to non-root user for security (optional, but recommended by Rasa)
# However, if you encounter permission issues during development, you can keep running as root via docker-compose
USER 1001

# Start Rasa with API enabled and point to the models directory
CMD ["run", "-m", "models", "--enable-api", "--cors", "*", "--port", "5005", "--debug"]