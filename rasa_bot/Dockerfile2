# rasa_bot/Dockerfile2
# rasa_server
FROM rasa/rasa:3.6.20-full

WORKDIR /app
USER root

# 1. Copy everything FROM rasa_bot folder INTO /app in the container
COPY . .

# 2. NOW change permissions (The folder exists now)
# If this still fails, it means your 'models' folder is empty or missing in GitHub
RUN mkdir -p /app/models && chmod -R 777 /app/models

USER 1001

# Enable API and CORS for your frontend
CMD ["run", "-m", "models", "--enable-api", "--cors", "*", "--port", "5005"]
