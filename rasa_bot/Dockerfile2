FROM rasa/rasa:3.6.20-full

WORKDIR /app
COPY . .

USER root
# Give permissions for the model folder
RUN chmod -R 777 /app
USER 1001

# Cloud Run uses the PORT variable, so we listen on 8080
ENTRYPOINT ["rasa", "run", "--enable-api", "--cors", "*", "--port", "8080"]
